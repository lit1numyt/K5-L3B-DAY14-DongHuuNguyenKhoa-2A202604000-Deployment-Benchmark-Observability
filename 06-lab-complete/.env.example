# Biến môi trường của agent — cp .env.example .env rồi điền giá trị thật.
# KHÔNG commit file .env (đã nằm trong .gitignore).

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — đặt một chuỗi ngẫu nhiên dài, vd: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# State (rate limit + cost guard)
REDIS_URL=redis://localhost:6379/0

# Giới hạn
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
